rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      allow read: if request.auth != null;
      // Anyone signed in (anonymously) can open a table and becomes its host.
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      // The host can change anything. During play, only the player whose turn it is can write.
      allow update: if request.auth != null && (
        resource.data.host == request.auth.uid ||
        (resource.data.status == 'play' && resource.data.order[resource.data.turn] == request.auth.uid)
      );

      match /players/{pid} {
        allow read: if request.auth != null;
        // You can seat yourself; the host can also seat friends who share their phone.
        allow create, update: if request.auth != null && (
          pid == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(code)).data.host == request.auth.uid
        );
      }
    }
  }
}

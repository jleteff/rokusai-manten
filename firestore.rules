rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Every player signs in with an email-and-password account and has confirmed their email.
    // Guest (anonymous) sessions and unconfirmed accounts can't see or touch any table.
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password' &&
        request.auth.token.email_verified == true;
    }

    match /rooms/{code} {
      function isHost() { return resource.data.host == request.auth.uid; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function myTurn() {
        return resource.data.status == 'play' && resource.data.order[resource.data.turn] == request.auth.uid;
      }

      // You can open a table if you know its code, but nobody can list every table.
      allow get: if signedIn();
      allow list: if false;
      // A new table always starts empty in the lobby. Everything after that runs on the server.
      allow create: if signedIn() && request.resource.data.host == request.auth.uid &&
        request.resource.data.status == 'lobby' &&
        request.resource.data.keys().hasOnly(['host', 'status', 'target', 'created', 'duelOf', 'duelPair']) &&
        request.resource.data.target in [2500, 5000, 10000];
      // Dice, scores, turns, seats and winners are only ever written by the server (Cloud Functions).
      // Phones may only: share the dice they're tapping (their turn), come back from auto-play,
      // and, for the host, pick the target in the lobby, lock the table, or mark a duel reported.
      allow update: if signedIn() && (
        (myTurn() && changed().hasOnly(['pick', 'pickRoll', 'auto']) &&
          (!changed().hasAny(['auto']) || request.resource.data.auto == null)) ||
        (isHost() && changed().hasOnly(['target', 'locked', 'duelReported']) &&
          (!changed().hasAny(['target']) || (resource.data.status == 'lobby' && request.resource.data.target in [2500, 5000, 10000])))
      );

      match /players/{pid} {
        function room() { return get(/databases/$(database)/documents/rooms/$(code)).data; }
        function roomHost() { return room().host == request.auth.uid; }
        function banned() { return request.auth.uid in room().get('banned', []); }

        allow read: if signedIn();
        // There are no bots: a seat is always the signed-in person sitting in it, never anyone else.
        // You can't sit down if the host removed you or locked the table.
        allow create: if signedIn() && pid == request.auth.uid && !banned() &&
          !('bot' in request.resource.data) &&
          (room().get('locked', false) != true || roomHost());
        // You can update your own seat (name, avatar, chat, challenges), and only your own.
        allow update: if signedIn() && pid == request.auth.uid && !banned() && !('bot' in request.resource.data);
        // You can always get up yourself. The host removes people through the server.
        allow delete: if signedIn() && pid == request.auth.uid;
      }
    }

    // Coins, levels and owned items: anyone signed in can see them (to show dice skins at the table),
    // only the server can change them.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}

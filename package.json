    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@revenuecat/purchases-capacitor": "^14.0.0",
    "firebase": "^12.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@capacitor/assets": "^4.0.0"
  }
